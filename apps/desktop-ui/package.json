{
  "name": "@shared-cockpit/desktop-ui",
  "private": true,
  "version": "0.1.0",
  "description": "Shared Cockpit UI - web-first, empacado como app de escritorio con Electron.",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "dist": "npm run build && electron-builder",
    "dist:publish": "npm run build && electron-builder --publish always"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3",
    "typescript": "^5.5.4",
    "vite": "^5.4.0"
  },
  "build": {
    "appId": "com.weconnect.sharedcockpit",
    "productName": "WeConnect",
    "files": ["dist/**/*", "electron/**/*"],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": ["nsis"],
      "signAndEditExecutable": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "drx2021585",
        "repo": "shared-cockpit-backup",
        "releaseType": "release"
      }
    ]
  }
}
