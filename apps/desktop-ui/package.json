{
  "name": "we-connect-desktop-ui",
  "private": true,
  "version": "0.1.51",
  "description": "We Connect - cliente de cabina compartida, web-first y empacado con Electron.",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "dist": "npm run build && electron-builder",
    "dist:publish": "npm run build && electron-builder --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "express": "^4.19.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18.0",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3",
    "typescript": "^5.5.4",
    "vite": "^5.4.0"
  },
  "build": {
    "appId": "com.weconnect.sharedcockpit",
    "productName": "We Connect",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "logos/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": "../../simulator/wasm-bridge/PackageSources",
        "to": "community-packages/WeConnectBridge"
      },
      {
        "from": "../simulator-bridge/src/SimulatorBridge/publish",
        "to": "bridge"
      },
      {
        "from": "../../aircraft-profiles",
        "to": "aircraft-profiles"
      }
    ],
    "win": {
      "icon": "logos/app-icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "installerIcon": "logos/app-icon.ico",
      "uninstallerIcon": "logos/app-icon.ico",
      "installerHeaderIcon": "logos/app-icon.ico",
      "shortcutName": "We Connect"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "drx2021585",
        "repo": "shared-cockpit-backup",
        "releaseType": "release"
      }
    ]
  }
}
