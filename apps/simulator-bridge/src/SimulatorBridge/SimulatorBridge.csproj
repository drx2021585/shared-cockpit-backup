<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- net8.0-windows7.0 (no solo net8.0): FSUIPCClientDLL publica un build nativo
         para este TFM. Sin el sufijo windows, NuGet caía al shim de compatibilidad
         de .NET Framework 4.6.2 (NU1701) en vez del ensamblado moderno real. -->
    <TargetFramework>net8.0-windows7.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SharedCockpit.Bridge</RootNamespace>
    <AssemblyName>SharedCockpit.Bridge</AssemblyName>
    <Version>0.1.70</Version>
    <FileVersion>0.1.70.0</FileVersion>
    <InformationalVersion>0.1.70</InformationalVersion>
    <!-- Sprint 1: proceso de consola simple con logging a stdout. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- P/Invoke a SimConnect.dll (nativa) solo funciona en Windows x64. -->
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FSUIPCClientDLL" Version="3.3.16" />
    <PackageReference Include="YamlDotNet" Version="16.2.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\config\**\*.json" Link="config\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\..\Recursos\SDK\Ifly B738M SDK\737MAX_SDK\sdk\**\*.*" Link="ifly-sdk\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
