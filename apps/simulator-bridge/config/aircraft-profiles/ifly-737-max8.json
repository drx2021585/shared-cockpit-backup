{
  "profileId": "ifly-737-max8",
  "displayName": "iFly Boeing 737 MAX 8",
  "sdkVersion": "REPLACE_WITH_REAL_IFLY_SDK_VERSION",
  "polling": {
    "readIntervalMs": 20,
    "heartbeatIntervalMs": 1000,
    "fullStateIntervalMs": 5000
  },
  "controls": [
    {
      "id": "overhead.battery",
      "type": "switch",
      "dataSource": "ifly-sdk",
      "syncMode": "state",
      "writable": false,
      "critical": true,
      "debounceMs": 40
    },
    {
      "id": "mcp.selectedAltitude",
      "type": "integer",
      "dataSource": "ifly-sdk",
      "syncMode": "value",
      "writable": false,
      "minimum": 0,
      "maximum": 50000,
      "step": 100,
      "debounceMs": 60,
      "tolerance": 0
    }
  ]
}
