{
  "bridge": {
    "name": "WeConnect.IFlyBridge",
    "localWebSocket": {
      "host": "127.0.0.1",
      "port": 17481,
      "allowedOrigins": [
        "http://localhost",
        "http://127.0.0.1"
      ]
    },
    "ifly": {
      "expectedSdkVersion": "1.5",
      "pollIntervalMs": 20,
      "mutexTimeoutMs": 250,
      "reconnectIntervalMs": 2000,
      "maximumSnapshotBytes": 262144,
      "pluginProcessName": "737MAX_Plugin",
      "simulatorProcessNames": [
        "FlightSimulator2024",
        "FlightSimulator"
      ],
      "pluginWindowTitles": [
        "iFly Plugin",
        "iFly Plugin - MSFS2024"
      ],
      "mutexName": "iFly737MAX_SDK_Mutex",
      "mappingName": "iFly737MAX_SDK_FileMappingObject",
      "commandChannelAvailable": true
    },
    "diagnostics": {
      "logEveryChange": true
    }
  }
}
